# Local example only. Supply real values through the deployment environment.
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=
# Comma-separated existing user IDs allowed to mutate CMS articles.
CMS_ADMIN_USER_IDS=
# Explicit trusted proxy IPs/CIDRs or Express named ranges. Empty means no proxy trust.
TRUST_PROXY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BASE_OFFICE_DOMAIN=https://office.base.vn
BASE_REQUEST_DOMAIN=https://request.base.vn
BASE_WEWORK_DOMAIN=https://wework.base.vn
BASE_VN_OFFICE_ACCESS_TOKEN=
BASE_VN_REQUEST_ACCESS_TOKEN=
BASE_VN_WEWORK_ACCESS_TOKEN=

# local is for development only; deployed environments require Cloudinary.
UPLOAD_STORAGE=cloudinary
